{%- doc -%}
  Product Variant Specification Matrix

  Renders a fully server-rendered ordering table, grouped one row per color,
  with every variant's full MPN, container size and NSN as crawlable text.

  This exists so that consolidating one-product-per-color into variants does
  not lose long-tail coverage for hyper-specific part-number searches. The
  variant dropdown is JavaScript-driven and its option values are not reliably
  indexed; this table is in the initial HTML response, so it is.

  Grouping by color keeps a 40-color x 3-size family at 40 rows rather than
  120, without dropping any MPN: each size's part number is a separate linked
  entry inside its color's row. Availability is shown inline and only when an
  item is NOT in stock, so a fully stocked family carries no status noise.

  Field resolution matches snippets/product-structured-data.liquid:
    1. variant metafield  (consolidated / post-migration products)
    2. product metafield  (legacy one-product-per-color entries)
    3. variant option value, matched by option NAME not position

  Metafields used:
  - variant mm-google-shopping.mpn (note: app-owned namespace, bracket syntax)
  - variant custom.nsn, custom.sae_color, custom.size
  - product custom.nsn, custom.lead_time

  Renders nothing for single-variant products, where a one-row table adds no value.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign current_variant_id = product.selected_or_first_available_variant.id

  # Legacy product-level fallbacks
  assign product_nsn = product.metafields.custom.nsn.value
  assign lead_time = product.metafields.custom.lead_time.value

  # Resolve option positions by NAME. Option order is not guaranteed across
  # products, so never index positionally.
  # has_color_option is tracked as an explicit boolean rather than testing a
  # nil sentinel: nil-vs-blank comparison is not portable across Liquid
  # implementations, and a wrong answer here silently empties the table.
  assign color_option_index = -1
  assign size_option_index = -1
  assign has_color_option = false
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'color' or option_name contains 'colour'
      assign color_option_index = forloop.index0
      assign color_option = option
      assign has_color_option = true
    elsif option_name contains 'size' or option_name contains 'volume' or option_name contains 'container' or option_name contains 'kit'
      assign size_option_index = forloop.index0
    endif
  endfor

  # Detection pass. Availability wording is only introduced when something is
  # actually unavailable.
  assign has_unavailable = false
  for variant in product.variants
    unless variant.available
      assign has_unavailable = true
    endunless
  endfor
-%}

{%- if product != blank and product.variants.size > 1 -%}
  <div
    class="variant-matrix variant-matrix--{{ block.id }} spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <h2 class="variant-matrix__heading">{{ block.settings.heading }}</h2>
    {%- endif -%}

    {%- if block.settings.intro != blank -%}
      <p class="variant-matrix__intro">{{ block.settings.intro }}</p>
    {%- endif -%}

    {%- comment -%}
      tabindex + role make the horizontally scrollable region reachable by
      keyboard, which a bare overflow container is not.
    {%- endcomment -%}
    <div
      class="variant-matrix__scroll"
      tabindex="0"
      role="region"
      aria-label="{{ block.settings.heading | default: 'Part number matrix' | escape }}"
    >
      <table class="variant-matrix__table">
        <caption class="variant-matrix__caption">
          {{ product.variants.size }} configurations available for {{ product.title | escape }}.
          {%- if has_unavailable %} Items without a status note are in stock.{% endif -%}
        </caption>
        <thead>
          <tr>
            <th scope="col">
              {%- if has_color_option -%}
                {{ block.settings.color_column_label | default: 'FED-STD-595 / Color' }}
              {%- else -%}
                Configuration
              {%- endif -%}
            </th>
            <th scope="col">{{ block.settings.parts_column_label | default: 'Manufacturer Part Numbers' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- if has_color_option -%}
            {%- for color_value in color_option.values -%}
              {%- comment -%}
                option.values yields option-value drops, not plain strings.
                Fall back to the raw value so this keeps working if that changes.
              {%- endcomment -%}
              {%- assign color_label = color_value.name | default: color_value -%}
              {%- render 'variant-matrix-row',
                product: product,
                group_label: color_label,
                filter_color: color_label,
                color_option_index: color_option_index,
                size_option_index: size_option_index,
                product_nsn: product_nsn,
                lead_time: lead_time,
                current_variant_id: current_variant_id,
                show_select: block.settings.link_to_variants
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%}
              No color axis: there is nothing to group by, so the table becomes
              a single flat part-number list.
            {%- endcomment -%}
            {%- render 'variant-matrix-row',
              product: product,
              group_label: product.title,
              filter_color: '',
              color_option_index: color_option_index,
              size_option_index: size_option_index,
              product_nsn: product_nsn,
              lead_time: lead_time,
              current_variant_id: current_variant_id,
              show_select: block.settings.link_to_variants
            -%}
          {%- endif -%}
        </tbody>
      </table>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .variant-matrix {
    width: 100%;
    margin-block-start: var(--margin-lg);
  }

  .variant-matrix__heading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-foreground-heading);
    margin: 0 0 var(--margin-sm) 0;
    padding-block-end: var(--padding-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .variant-matrix__intro {
    font-size: var(--font-size--sm);
    color: var(--color-foreground-secondary);
    margin: 0 0 var(--margin-md) 0;
  }

  /* Dense spec tables are legitimately wide. Scroll the table, never the page. */
  .variant-matrix__scroll {
    overflow-x: auto;
    max-width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-buttons-primary, 4px);
  }

  .variant-matrix__scroll:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .variant-matrix__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size--sm);
    font-family: var(--font-body--family);
  }

  .variant-matrix__caption {
    text-align: left;
    padding: var(--padding-sm) var(--padding-md);
    font-size: var(--font-size--xs);
    color: var(--color-foreground-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .variant-matrix__table thead th {
    text-align: left;
    white-space: nowrap;
    padding: var(--padding-sm) var(--padding-md);
    font-size: var(--font-size--xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-foreground-secondary);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .variant-matrix__cell {
    padding: var(--padding-sm) var(--padding-md);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    vertical-align: top;
    text-align: left;
  }

  .variant-matrix__row:last-child .variant-matrix__cell {
    border-bottom: none;
  }

  .variant-matrix__row:hover {
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }

  .variant-matrix__row--active {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .variant-matrix__cell--color {
    white-space: nowrap;
    font-weight: var(--font-weight-medium);
    color: var(--color-foreground);
  }

  /* Part number entries */
  .variant-matrix__parts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .variant-matrix__part {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gap-2xs) var(--gap-md);
    line-height: 1.5;
  }

  .variant-matrix__part-mpn {
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
    min-width: 14ch;
  }

  a.variant-matrix__part-mpn {
    color: var(--color-primary);
    text-decoration: none;
  }

  a.variant-matrix__part-mpn:hover {
    text-decoration: underline;
  }

  .variant-matrix__part--active .variant-matrix__part-mpn {
    text-decoration: underline;
  }

  .variant-matrix__part-size {
    color: var(--color-foreground-secondary);
    min-width: 10ch;
  }

  .variant-matrix__part-nsn {
    color: var(--color-foreground-secondary);
    font-variant-numeric: tabular-nums;
  }

  .variant-matrix__part-nsn abbr {
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
    cursor: help;
  }

  .variant-matrix__status {
    white-space: nowrap;
    font-size: var(--font-size--xs);
  }

  .variant-matrix__status--lead {
    color: rgb(180 83 9);
  }

  .variant-matrix__status--out {
    color: var(--color-foreground-secondary);
  }

  @media screen and (max-width: 749px) {
    .variant-matrix__cell,
    .variant-matrix__table thead th {
      padding: var(--padding-xs) var(--padding-sm);
    }

    .variant-matrix__part-mpn,
    .variant-matrix__part-size {
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Variant Spec Matrix",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete Part Numbers & Ordering Matrix"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "info": "Optional line shown above the table."
    },
    {
      "type": "text",
      "id": "color_column_label",
      "label": "Color column label",
      "default": "FED-STD-595 / Color"
    },
    {
      "type": "text",
      "id": "parts_column_label",
      "label": "Part number column label",
      "default": "Manufacturer Part Numbers"
    },
    {
      "type": "checkbox",
      "id": "link_to_variants",
      "label": "Link part numbers to variants",
      "info": "Each part number links to its variant. Also gives crawlers a path to every variant URL. Turn off to reduce internal links.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Variant Spec Matrix",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
